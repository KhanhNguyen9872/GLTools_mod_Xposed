<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.gltools.offline.xposed">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="GLTools Offline Revival"
        android:theme="@style/Theme.Material3.DayNight.NoActionBar">

        <!-- Declaración de módulo Xposed -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="Redirige tráfico de GLTools a servidor mock local. No modifica licencia." />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

        <!-- Servicio mock embebido -->
        <service
            android:name="com.gltools.offline.server.GLToolsMockService"
            android:enabled="true"
            android:exported="false"
            android:process=":mock_server" />

    </application>
</manifest>
